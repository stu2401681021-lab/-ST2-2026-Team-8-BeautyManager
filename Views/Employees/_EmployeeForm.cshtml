@model BeautyManager.Models.Employee

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label">Име</label>
    <input asp-for="Name" class="form-control" placeholder="Въведете име и фамилия..." />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Specialty" class="form-label">Специалност</label>
    <select asp-for="Specialty" class="form-select">
        <option value="">-- Изберете специалност --</option>
        <option value="Фризьор">Фризьор</option>
        <option value="Козметик">Козметик</option>
        <option value="Маникюрист">Маникюрист</option>
        <option value="Гримьор">Гримьор</option>
        <option value="Масажист">Масажист</option>
    </select>
    <span asp-validation-for="Specialty" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Phone" class="form-label">Телефон</label>
    <input asp-for="Phone" class="form-control" placeholder="+359888123456" />
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>

<div class="mt-4">
    <button type="submit" class="btn btn-primary me-2">Запази</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
</div>
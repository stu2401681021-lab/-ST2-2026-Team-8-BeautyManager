@model BeautyManager.Models.AiQuestion

@{
    ViewData["Title"] = "AI асистент";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

<style>
    .ai-formatted-content p:last-child {
        margin-bottom: 0;
    }

    .ai-formatted-content ul, .ai-formatted-content ol {
        padding-left: 1.5rem;
        margin-bottom: 1rem;
    }

    .ai-formatted-content table {
        width: 100%;
        margin-top: 0.75rem;
        margin-bottom: 1rem;
        border-collapse: collapse;
        background-color: #ffffff;
    }

    .ai-formatted-content th, .ai-formatted-content td {
        border: 1px solid #dee2e6;
        padding: 8px 12px;
        text-align: left;
    }

    .ai-formatted-content th {
        background-color: #f8f9fa;
        font-weight: 600;
    }

    .ai-formatted-content blockquote {
        border-left: 4px solid #ec4899;
        padding-left: 1rem;
        color: #6c757d;
        margin: 1rem 0;
    }

    pre code.hljs {
        border-radius: 8px;
        padding: 1rem;
        font-family: 'Fira Code', 'Courier New', Courier, monospace;
        font-size: 0.875rem;
    }

    .json-badge {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        background: #8b5cf6;
        color: white;
        padding: 3px 10px;
        border-radius: 6px;
        display: inline-block;
        margin-bottom: 10px;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-10">

        <div class="card shadow-sm border-0 mb-4 rounded-4 bg-gradient-soft">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center">
                        <span class="fs-1 me-3">🤖</span>
                        <div>
                            <h2 class="card-title m-0 fw-bold">AI Асистент</h2>
                            <p class="text-muted mb-0 small">Вашият интелигентен помощник в BeautyManager</p>
                        </div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-semibold">
                        ✨ Връзка с езиков модел
                    </span>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small fw-semibold">Бързи въпроси за тестване:</label>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="setPrompt('Върни списък с всички предлагани услуги')">
                    💅 Списък с услуги
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="setPrompt('Какви са най-популярните процедури?')">
                    ⭐ Популярни процедури
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="setPrompt('Напиши кратко приветствено съобщение за нов клиент')">
                    ✉️ Приветствено съобщение
                </button>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body p-4">
                <form method="post" asp-action="Index" id="aiForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Question" class="form-label fw-bold m-0">Вашият въпрос / Заявка</label>
                            <span id="charCounter" class="text-muted small">0 символа</span>
                        </div>
                        <textarea asp-for="Question" id="questionInput" class="form-control rounded-3 p-3 shadow-none border" rows="4" placeholder="Въведете вашата заявка тук..." oninput="updateCounter()"></textarea>
                        <span asp-validation-for="Question" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="text-muted small">
                            🔒 <span>Не въвеждайте лични данни на клиенти (ЕГН, телефони).</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button type="submit" id="submitBtn" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">
                                ✨ Попитай AI
                            </button>
                        </div>
                    </div>

                    <div id="loadingSpinner" class="mt-3 p-3 bg-light rounded-3 text-primary text-center" style="display:none;">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        <span class="fw-semibold">AI анализира вашата заявка, моля изчакайте...</span>
                    </div>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model?.Error))
        {
            <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-center gap-3 p-3 mb-4" role="alert">
                <span class="fs-4">
                    ⚠️
                    </span>
                <div>
                    <strong class="d-block">Възникна грешка:</strong>
                    <span>@Model.Error</span>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model?.Answer))
        {
            <div class="card shadow border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-success text-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                        <span>
                            💬
                        </span> 
                        Отговор от AI
                    </h5>

                    <button type="button"
                            id="copyBtn"
                            class="btn btn-sm btn-light rounded-pill px-3 fw-semibold"
                            onclick="copyAnswer()">
                        📋 Копирай
                    </button>
                </div>

                <div class="card-body p-4 bg-light">
                    <div id="rawAnswer" style="display:none;">@Model.Answer</div>
                    <div id="aiAnswerFormatted" class="p-4 bg-white rounded-3 border shadow-sm ai-formatted-content">
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setPrompt(text) {
            var textarea = document.getElementById('questionInput');
            if (textarea) {
                textarea.value = text;
                updateCounter();
                textarea.focus();
            }
        }

        function updateCounter() {
            var textarea = document.getElementById('questionInput');
            var counter = document.getElementById('charCounter');
            if (textarea && counter) {
                counter.innerText = textarea.value.length + ' символа';
            }
        }

        var aiForm = document.getElementById('aiForm');
        if (aiForm) {
            aiForm.addEventListener('submit', function (e) {
                var textarea = document.getElementById('questionInput');

                if (textarea && textarea.value.trim() !== '') {
                    document.getElementById('loadingSpinner').style.display = 'block';

                    var btn = document.getElementById('submitBtn');
                    btn.classList.add('disabled');
                    btn.innerHTML = 'Зареждане...';
                }
            });
        }

        function copyAnswer() {
            var rawElement = document.getElementById('rawAnswer');
            if (!rawElement) return;

            navigator.clipboard.writeText(rawElement.innerText).then(function () {
                var copyBtn = document.getElementById('copyBtn');
                var originalText = copyBtn.innerHTML;
                copyBtn.innerHTML = '✅ Копирано!';
                setTimeout(function () {
                    copyBtn.innerHTML = originalText;
                }, 2000);
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            updateCounter();

            var rawAnswerEl = document.getElementById('rawAnswer');
            var formattedEl = document.getElementById('aiAnswerFormatted');

            if (rawAnswerEl && formattedEl) {
                var rawText = rawAnswerEl.innerText.trim();

                try {
                    var parsedJson = JSON.parse(rawText);
                    var prettyJson = JSON.stringify(parsedJson, null, 2);
                    var highlightedJson = hljs.highlight(prettyJson, { language: 'json' }).value;

                    formattedEl.innerHTML =
                        '<span class="json-badge">Генерирана JSON Заявка</span>' +
                        '<pre class="m-0"><code class="hljs language-json">' + highlightedJson + '</code></pre>';
                    return;
                } catch (e) {
                }

                if (typeof marked !== 'undefined') {
                    marked.setOptions({
                        highlight: function (code, lang) {
                            var language = hljs.getLanguage(lang) ? lang : 'plaintext';
                            return hljs.highlight(code, { language: language }).value;
                        },
                        breaks: true
                    });

                    formattedEl.innerHTML = marked.parse(rawText);

                    formattedEl.querySelectorAll('pre code').forEach(function (block) {
                        hljs.highlightElement(block);
                    });
                } else {
                    formattedEl.innerText = rawText;
                }
            }
        });
    </script>
}
@using System.Linq
@model IEnumerable<BeautyManager.Models.Service>

@{
    ViewData["Title"] = "Услуги";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-2">Услуги</h1>
        <p class="text-muted mb-0">
            Управление на услугите, цените и продължителността им.
        </p>
    </div>

    <a asp-controller="Services"
       asp-action="Create"
       class="btn btn-primary">
        + Добави услуга
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-controller="Services"
              asp-action="Index"
              method="get">

            <label class="form-label">
                Търсене на услуга
            </label>

            <div class="input-group">
                <input type="text"
                       name="filter"
                       value="@ViewBag.Filter"
                       class="form-control"
                       placeholder="Име или категория..." />

                <button type="submit"
                        class="btn btn-primary">
                    Търси
                </button>

                <a asp-controller="Services"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Изчисти
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="mb-3">
            Услуги (@ViewBag.TotalCount)
        </h5>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Име</th>
                        <th>Категория</th>
                        <th>Цена</th>
                        <th>Продължителност</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-4">
                                Няма намерени услуги.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var service in Model)
                        {
                            <tr>
                                <td>@service.Id</td>

                                <td>
                                    <strong>@service.Name</strong>
                                </td>

                                <td>@service.Category</td>

                                <td>@service.Price.ToString("F2") €</td>

                                <td>@service.DurationMinutes мин.</td>


                                <td>
                                    <div class="d-flex gap-2">

                                        <a asp-controller="Services"
                                           asp-action="Details"
                                           asp-route-id="@service.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Детайли
                                        </a>

                                        <a asp-controller="Services"
                                           asp-action="Edit"
                                           asp-route-id="@service.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Редактирай
                                        </a>

                                        <a asp-controller="Services"
                                           asp-action="Delete"
                                           asp-route-id="@service.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Изтрий
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                </tbody>
            </table>
            <partial name="_Pagination" />
        </div>
    </div>
</div>

@using System.Linq
@model IEnumerable<BeautyManager.Models.Service>

@{
    ViewData["Title"] = "Услуги";
    string filter = ViewBag.Filter as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-2">Услуги</h1>
        <p class="text-muted mb-0">
            Управление на услугите, цените и продължителността им.
        </p>
    </div>

    <a asp-controller="Services"
       asp-action="Create"
       class="btn btn-primary">
        + Добави услуга
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-controller="Services"
              asp-action="Index"
              method="get">

            <label class="form-label">
                Търсене на услуга
            </label>

            <div class="input-group">
                <input type="text"
                       name="filter"
                       value="@filter"
                       class="form-control"
                       placeholder="Име или категория..." />

                <button type="submit"
                        class="btn btn-primary">
                    Търси
                </button>

                <a asp-controller="Services"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Изчисти
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <h5 class="mb-3">
            Услуги (@ViewBag.TotalItems)
        </h5>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Име</th>
                        <th>Категория</th>
                        <th>Цена</th>
                        <th>Продължителност</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-4">
                                Няма намерени услуги.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var service in Model)
                        {
                            <tr>
                                <td>@service.Id</td>

                                <td>
                                    <strong>@service.Name</strong>
                                </td>

                                <td>@service.Category</td>

                                <td>@service.Price.ToString("F2") €</td>

                                <td>@service.DurationMinutes мин.</td>

                                <td>
                                    <div class="d-flex gap-2">

                                        <a asp-controller="Services"
                                           asp-action="Details"
                                           asp-route-id="@service.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Детайли
                                        </a>

                                        <a asp-controller="Services"
                                           asp-action="Edit"
                                           asp-route-id="@service.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Редактирай
                                        </a>

                                        <a asp-controller="Services"
                                           asp-action="Delete"
                                           asp-route-id="@service.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Изтрий
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if ((int)ViewBag.TotalPages > 0)
        {
            <div class="d-flex justify-content-center align-items-center flex-wrap gap-2 mt-4">

                @if ((int)ViewBag.CurrentPage > 1)
                {
                    <a asp-controller="Services"
                       asp-action="Index"
                       asp-route-filter="@filter"
                       asp-route-page="1"
                       asp-route-pageSize="@ViewBag.PageSize"
                       class="btn btn-outline-primary">
                        &laquo; Първа
                    </a>

                    <a asp-controller="Services"
                       asp-action="Index"
                       asp-route-filter="@filter"
                       asp-route-page="@((int)ViewBag.CurrentPage - 1)"
                       asp-route-pageSize="@ViewBag.PageSize"
                       class="btn btn-outline-primary">
                        &larr; Предишна
                    </a>
                }

                <span class="mx-2">
                    Страница @ViewBag.CurrentPage от @ViewBag.TotalPages
                </span>

                @if ((int)ViewBag.CurrentPage < (int)ViewBag.TotalPages)
                {
                    <a asp-controller="Services"
                       asp-action="Index"
                       asp-route-filter="@filter"
                       asp-route-page="@((int)ViewBag.CurrentPage + 1)"
                       asp-route-pageSize="@ViewBag.PageSize"
                       class="btn btn-outline-primary">
                        Следваща &rarr;
                    </a>

                    <a asp-controller="Services"
                       asp-action="Index"
                       asp-route-filter="@filter"
                       asp-route-page="@ViewBag.TotalPages"
                       asp-route-pageSize="@ViewBag.PageSize"
                       class="btn btn-outline-primary">
                        Последна &raquo;
                    </a>
                }

            </div>
        }

    </div>
</div>

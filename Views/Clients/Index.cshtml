@model IReadOnlyList<BeautyManager.Models.Client>

@{
    ViewData["Title"] = "Списък с клиенти";
    string search = ViewBag.Search as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-2">Списък с клиенти</h1>
        <p class="text-muted mb-0">
            Преглед и управление на клиентите в BeautyManager
        </p>
    </div>

    <a asp-controller="Clients"
       asp-action="Create"
       class="btn btn-primary">
        + Добави клиент
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">

        <form asp-controller="Clients"
              asp-action="Index"
              method="get">

            <label class="form-label">
                Търсене на клиент
            </label>

            <div class="input-group">
                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control"
                       placeholder="Име, телефон, услуга..." />

                <button type="submit"
                        class="btn btn-primary">
                    Търси
                </button>

                <a asp-controller="Clients"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Изчисти
                </a>
            </div>

        </form>

    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <h5 class="mb-3">
            Клиенти (@ViewBag.TotalItems)
        </h5>

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Име</th>
                        <th>Телефон</th>
                        <th>Имейл</th>
                        <th>Услуга</th>
                        <th>Специалист</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                Няма намерени клиенти.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var client in Model)
                        {
                            <tr>
                                <td>@client.Id</td>

                                <td>
                                    <strong>@client.Name</strong>
                                </td>

                                <td>@client.Phone</td>

                                <td>@client.Email</td>

                                <td>
                                    @(client.Service ?? "-")
                                </td>

                                <td>
                                    @(client.Specialist ?? "-")
                                </td>

                                <td>
                                    <div class="d-flex gap-2">

                                        <a asp-controller="Clients"
                                           asp-action="Edit"
                                           asp-route-id="@client.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Редактирай
                                        </a>

                                        <a asp-controller="Clients"
                                           asp-action="Delete"
                                           asp-route-id="@client.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Изтрий
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

        <!-- Странициране -->
        @if ((int)ViewBag.TotalPages > 0)
        {
            <div class="d-flex justify-content-center
                        align-items-center flex-wrap gap-2 mt-4">

                @if ((int)ViewBag.CurrentPage > 1)
                {
                    <a asp-controller="Clients"
                       asp-action="Index"
                       asp-route-search="@search"
                       asp-route-page="1"
                       asp-route-pageSize="@ViewBag.PageSize"
                       class="btn btn-outline-primary">
                        &laquo; Първа
                    </a>

                    <a asp-controller="Clients"
                       asp-action="Index"
                       asp-route-search="@search"
                       asp-route-page="@((int)ViewBag.CurrentPage - 1)"
                       asp-route-pageSize="@ViewBag.PageSize"
                       class="btn btn-outline-primary">
                        &larr; Предишна
                    </a>
                }

                <span class="mx-2">
                    Страница @ViewBag.CurrentPage от @ViewBag.TotalPages
                </span>

                @if ((int)ViewBag.CurrentPage < (int)ViewBag.TotalPages)
                {
                    <a asp-controller="Clients"
                       asp-action="Index"
                       asp-route-search="@search"
                       asp-route-page="@((int)ViewBag.CurrentPage + 1)"
                       asp-route-pageSize="@ViewBag.PageSize"
                       class="btn btn-outline-primary">
                        Следваща &rarr;
                    </a>

                    <a asp-controller="Clients"
                       asp-action="Index"
                       asp-route-search="@search"
                       asp-route-page="@ViewBag.TotalPages"
                       asp-route-pageSize="@ViewBag.PageSize"
                       class="btn btn-outline-primary">
                        Последна &raquo;
                    </a>
                }

            </div>
        }

    </div>
</div>

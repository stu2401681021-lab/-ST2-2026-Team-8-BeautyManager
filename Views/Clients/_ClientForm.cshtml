@model BeautyManager.Models.Client

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label">Име</label>
    <input asp-for="Name" class="form-control" placeholder="Въведете име" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Phone" class="form-label">Телефон</label>
    <input asp-for="Phone" class="form-control" placeholder="+359888123456" />
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Email" class="form-label">Е-маил</label>
    <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>


<div class="mb-3">
    <label asp-for="Service" class="form-label">Услуга</label>

    <select asp-for="Service"
            asp-items="ViewBag.Services"
            class="form-select">
        <option value="">-- Избери услуга --</option>
    </select>

    <span asp-validation-for="Service"
          class="text-danger"></span>
</div>


<div class="mb-3">
    <label asp-for="Specialist" class="form-label">Специалист</label>
    <select asp-for="Specialist" id="specialistSelect" class="form-select">
        <option value="">Изберете специалист</option>
        <option value="Маникюрист">Маникюрист</option>
        <option value="Фризьор">Фризьор</option>
        <option value="Козметик">Козметик</option>
        <option value="Специалист Миглопластика">Специалист Миглопластика</option>
    </select>
    <span asp-validation-for="Specialist" class="text-danger"></span>
</div>



<script>
    document.getElementById('serviceSelect')?.addEventListener('change', function () {
        const service = this.value;
        const specialistSelect = document.getElementById('specialistSelect');

        if (!specialistSelect) return;

        if (service === 'Маникюр' || service === 'Педикюр') {
            specialistSelect.value = 'Маникюрист';
        } else if (service === 'Подстригване' || service === 'Боядисване') {
            specialistSelect.value = 'Фризьор';
        } else if (service === 'Почистване на лице') {
            specialistSelect.value = 'Козметик';
        } else if (service === 'Миглопластика') {
            specialistSelect.value = 'Специалист Миглопластика';
        }
    });
</script>

<div class="mt-4">
    <button type="submit" class="btn btn-primary me-2">Запази</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
</div>